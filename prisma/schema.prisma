datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MODEL
  AGENCY
  BRAND
  CLIENT
  ADMIN
}

enum VerificationLevel {
  UNVERIFIED
  AGENCY_VERIFIED
  LUXLANE_VERIFIED
}

enum AvailabilityStatus {
  AVAILABLE
  HOLD
  BOOKED
}

enum CastingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CastingType {
  RUNWAY
  CAMPAIGN
  EDITORIAL
  EVENT
  OTHER
}

enum SubmissionStatus {
  APPLIED
  SUBMITTED
  SHORTLISTED
  OFFERED
  ACCEPTED
  DECLINED
  CONFIRMED
  REJECTED
}

enum NotificationType {
  INVITE
  OFFER
  SHORTLISTED
  CONFIRMED
  SYSTEM
}

enum MediaType {
  AVATAR
  PORTFOLIO
  POLAROID
  DOCUMENT
  TWIN_INPUT
  TWIN_OUTPUT
}

enum TwinStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            Role
  bio             String?
  locationCity    String?   @map("location_city")
  avatarUrl       String?   @map("avatar_url")
  onboardingComplete Boolean? @default(false) @map("onboarding_complete")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  profile             Profile?
  modelProfile        ModelProfile?
  agencyProfile       AgencyProfile?
  brandProfile        BrandProfile?
  refreshTokens       RefreshToken[]
  followers           Follow[]              @relation("followers")
  following           Follow[]              @relation("following")
  notifications       Notification[]
  conversationMembers ConversationMember[]
  messages            Message[]             @relation("sentMessages")
  castings            Casting[]             @relation("createdCastings")
  submissions         Submission[]          @relation("modelSubmissions")
  savedCastings       SavedCasting[]
  mediaAssets         MediaAsset[]
  settings            UserSettings?
  posts               Post[]
  postLikes           PostLike[]
  postSaves           PostSave[]
  comments            Comment[]

  @@map("users")
}

model Profile {
  userId             String            @id @map("user_id")
  displayName        String            @map("display_name")
  bio                String?
  location           String?
  height             String?
  hair               String?
  eyes               String?
  experience         String?
  verificationStatus VerificationLevel @default(UNVERIFIED) @map("verification_status")
  score              Int               @default(0)
  avatarUrl          String?           @map("avatar_url")
  coverUrl           String?           @map("cover_url")
  updatedAt          DateTime?         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ModelProfile {
  userId            String             @id
  heightCm          Int?
  bustCm            Int?
  waistCm           Int?
  hipsCm            Int?
  shoeSize          String?
  hair              String?
  eyes              String?
  languages         String[]
  availability      AvailabilityStatus @default(AVAILABLE)
  agencyId          String?
  verificationLevel VerificationLevel  @default(UNVERIFIED)
  luxlaneScore      Int                @default(0)
  details           Json?              // extended: dressSize, inseam, experience tags, etc.

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalTwin DigitalTwin?

  @@map("model_profiles")
}

model AgencyProfile {
  userId     String  @id
  agencyName String
  website    String?
  verified   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agency_profiles")
}

model BrandProfile {
  userId    String  @id
  brandName String
  website   String?
  verified  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Casting {
  id          String        @id @default(uuid())
  createdBy   String
  title       String
  type        CastingType
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  payMin      Int?
  payMax      Int?
  deadline    DateTime?
  status      CastingStatus @default(DRAFT)

  verifiedOnly            Boolean @default(false)
  requireDigitalTwin      Boolean @default(false)
  maxSubmissionsPerAgency Int?

  requirements   CastingRequirement?
  submissions    Submission[]
  savedBy        SavedCasting[]
  rooms          Conversation[] @relation("castingRooms")
  creator        User           @relation("createdCastings", fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdBy])
  @@map("castings")
}

model SavedCasting {
  userId    String
  castingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)

  @@id([userId, castingId])
  @@index([castingId])
  @@map("saved_castings")
}

model CastingRequirement {
  castingId   String   @id
  minHeightCm Int?
  maxHeightCm Int?
  tags        String[]
  notes       String?

  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)

  @@map("casting_requirements")
}

model Submission {
  id          String           @id @default(uuid())
  castingId   String
  modelId     String
  submittedBy String
  status      SubmissionStatus @default(APPLIED)
  note        String?

  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)
  model   User    @relation("modelSubmissions", fields: [modelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([castingId, modelId])
  @@index([castingId, status])
  @@index([modelId, status])
  @@map("submissions")
}

model Conversation {
  id        String   @id @default(uuid())
  type      String // "direct" | "casting_room"
  castingId String?
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
  casting  Casting?             @relation("castingRooms", fields: [castingId], references: [id], onDelete: SetNull)

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model MediaAsset {
  id        String    @id @default(uuid())
  ownerId   String
  type      MediaType
  url       String
  meta      Json?
  createdAt DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
  @@map("media_assets")
}

model DigitalTwin {
  userId     String     @id
  status     TwinStatus @default(NONE)
  summary    Json?
  previewUrl String?
  modelUrl   String?    // .glb / .usdz for 3D viewer
  updatedAt  DateTime   @updatedAt

  user ModelProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("digital_twins")
}

model UserSettings {
  userId       String   @id
  pushNotifs   Boolean  @default(true)
  emailNotifs  Boolean  @default(true)
  darkMode     Boolean  @default(true)
  privacyMode  String   @default("public")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]

  @@index([userId])
  @@map("posts")
}

model PostLike {
  userId String
  postId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model PostSave {
  userId   String
  postId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_saves")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}
