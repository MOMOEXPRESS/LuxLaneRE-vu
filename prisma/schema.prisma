datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MODEL
  AGENCY
  BRAND
  CLIENT
  ADMIN
}

enum VerificationLevel {
  UNVERIFIED
  AGENCY_VERIFIED
  LUXLANE_VERIFIED
}

enum AvailabilityStatus {
  AVAILABLE
  HOLD
  BOOKED
}

enum CastingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CastingType {
  RUNWAY
  CAMPAIGN
  EDITORIAL
  EVENT
  OTHER
}

enum SubmissionStatus {
  APPLIED
  SUBMITTED
  SHORTLISTED
  OFFERED
  ACCEPTED
  DECLINED
  CONFIRMED
  REJECTED
}

enum NotificationType {
  INVITE
  OFFER
  SHORTLISTED
  CONFIRMED
  SYSTEM
}

enum MediaType {
  AVATAR
  PORTFOLIO
  POLAROID
  DOCUMENT
  TWIN_INPUT
  TWIN_OUTPUT
}

enum TwinStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            Role
  bio             String?
  locationCity    String?   @map("location_city")
  avatarUrl       String?   @map("avatar_url")
  onboardingComplete Boolean? @default(false) @map("onboarding_complete")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  profile             Profile?
  modelProfile        ModelProfile?
  agencyProfile       AgencyProfile?
  brandProfile        BrandProfile?
  clientProfile       ClientProfile?
  refreshTokens       RefreshToken[]
  followers           Follow[]              @relation("followers")
  following           Follow[]              @relation("following")
  agencyAppsAsModel   AgencyApplication[]   @relation("agencyApplicationsAsModel")
  agencyAppsAsAgency  AgencyApplication[]   @relation("agencyApplicationsAsAgency")
  availabilityDates   AvailabilityDate[]
  notifications       Notification[]
  conversationMembers ConversationMember[]
  messages            Message[]             @relation("sentMessages")
  castings            Casting[]             @relation("createdCastings")
  submissions         Submission[]          @relation("modelSubmissions")
  savedCastings       SavedCasting[]
  savedModels         SavedModel[]          @relation("savedModelsByUser")
  savedByUsers        SavedModel[]          @relation("savedModelsOfUser")
  mediaAssets         MediaAsset[]
  settings            UserSettings?
  posts               Post[]
  postLikes           PostLike[]
  postSaves           PostSave[]
  comments            Comment[]
  blockedUsers        Block[]               @relation("blockerUser")
  blockedByUsers      Block[]               @relation("blockedUser")
  reportsCreated      Report[]              @relation("reportCreator")
  reportsReceived     Report[]              @relation("reportTarget")
  profileViews        ProfileView[]         @relation("profileViews")
  profileViewsBy      ProfileView[]         @relation("profileViewsBy")
  castingViewsBy      CastingView[]         @relation("castingViewsBy")
  earnings            Earning[]             @relation("userEarnings")
  stories             Story[]               @relation("userStories")
  storyViewsBy        StoryView[]           @relation("storyViewsBy")
  highlights          StoryHighlight[]      @relation("userHighlights")
  brandBookings       DirectBooking[]       @relation("brandBookings")
  modelBookings       DirectBooking[]       @relation("modelBookings")

  @@map("users")
}

model Profile {
  userId             String    @id @map("user_id")
  displayName        String    @map("display_name")
  bio                String?
  location           String?
  height             String?
  hair               String?
  eyes               String?
  experience         String?
  verificationStatus VerificationLevel @default(UNVERIFIED) @map("verification_status")
  score              Int       @default(0)
  avatarUrl          String?   @map("avatar_url")
  coverUrl           String?   @map("cover_url")
  socialLinks        Json?     @default("{}") @map("social_links")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ModelProfile {
  userId            String             @id @map("user_id")
  heightCm          Int?               @map("height_cm")
  bustCm            Int?               @map("bust_cm")
  waistCm           Int?               @map("waist_cm")
  hipsCm            Int?               @map("hips_cm")
  shoeSize          String?            @map("shoe_size")
  hair              String?
  eyes              String?
  languages         String[]
  availability      AvailabilityStatus @default(AVAILABLE)
  agencyId          String?            @map("agency_id")
  verificationLevel VerificationLevel  @default(UNVERIFIED) @map("verification_level")
  luxlaneScore      Int                @default(0) @map("luxlane_score")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalTwin DigitalTwin?

  @@map("model_profiles")
}

model AgencyProfile {
  userId         String   @id
  agencyName     String
  website        String?
  verified       Boolean  @default(false)
  commissionRate Decimal? @default(20.00) @map("commission_rate")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agency_profiles")
}

model BrandProfile {
  userId    String  @id @map("user_id")
  brandName String  @map("brand_name")
  website   String?
  verified  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model ClientProfile {
  userId     String  @id
  clientName String
  website    String?
  industry   String?
  verified   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model AgencyApplication {
  id        String   @id @default(uuid())
  modelId   String
  agencyId  String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model  User @relation("agencyApplicationsAsModel", fields: [modelId], references: [id], onDelete: Cascade)
  agency User @relation("agencyApplicationsAsAgency", fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([modelId, agencyId])
  @@index([agencyId, status])
  @@map("agency_applications")
}

model AvailabilityDate {
  id     String   @id @default(uuid())
  userId String
  date   DateTime
  status String   @default("AVAILABLE") // AVAILABLE, HOLD, BOOKED

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("availability_dates")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Casting {
  id          String        @id @default(uuid())
  createdBy   String        @map("created_by")
  title       String
  type        CastingType
  description String?
  location    String?
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  payMin      Int?          @map("pay_min")
  payMax      Int?          @map("pay_max")
  deadline    DateTime?
  status      CastingStatus @default(DRAFT)

  verifiedOnly            Boolean @default(false) @map("verified_only")
  requireDigitalTwin      Boolean @default(false) @map("require_digital_twin")
  maxSubmissionsPerAgency Int?    @map("max_submissions_per_agency")

  requirements   CastingRequirement?
  submissions    Submission[]
  savedBy        SavedCasting[]
  rooms          Conversation[] @relation("castingRooms")
  views          CastingView[]
  earnings       Earning[]
  budget         Int?
  creator        User           @relation("createdCastings", fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdBy])
  @@map("castings")
}

model SavedCasting {
  userId    String   @map("user_id")
  castingId String   @map("casting_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)

  @@id([userId, castingId])
  @@index([castingId])
  @@map("saved_castings")
}

model CastingRequirement {
  castingId   String   @id @map("casting_id")
  minHeightCm Int?     @map("min_height_cm")
  maxHeightCm Int?     @map("max_height_cm")
  tags        String[]
  notes       String?

  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)

  @@map("casting_requirements")
}

model Submission {
  id          String           @id @default(uuid())
  castingId   String           @map("casting_id")
  modelId     String           @map("model_id")
  submittedBy String           @map("submitted_by")
  status      SubmissionStatus @default(APPLIED)
  note        String?

  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)
  model   User    @relation("modelSubmissions", fields: [modelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([castingId, modelId])
  @@index([castingId, status])
  @@index([modelId, status])
  @@map("submissions")
}

model Conversation {
  id        String   @id @default(uuid())
  type      String // "direct" | "casting_room"
  castingId String?  @map("casting_id")
  createdAt DateTime @default(now()) @map("created_at")

  members       ConversationMember[]
  messages      Message[]
  casting       Casting?             @relation("castingRooms", fields: [castingId], references: [id], onDelete: SetNull)
  roomEvents    RoomEvent[]
  roomFiles     RoomFile[]
  roomSchedules RoomScheduleItem[]

  @@map("conversations")
}

model RoomEvent {
  id           String   @id @default(uuid())
  roomId       String
  type         String   // "created" | "submission" | "shortlisted" | "offer_sent" | "offer_accepted" | "member_added" | "message"
  userId       String
  targetUserId String?
  message      String?
  createdAt    DateTime @default(now())

  room Conversation @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("room_events")
}

model RoomFile {
  id         String   @id @default(uuid())
  roomId     String
  name       String
  type       String   // "moodboard" | "callsheet" | "contract" | "other"
  url        String
  uploadedBy String
  createdAt  DateTime @default(now())

  room Conversation @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_files")
}

model RoomScheduleItem {
  id       String   @id @default(uuid())
  roomId   String
  title    String
  date     DateTime
  time     String
  location String?
  notes    String?

  room Conversation @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_schedule_items")
}

model ConversationMember {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String
  attachmentUrl  String?  @map("attachment_url")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model MediaAsset {
  id        String    @id @default(uuid())
  ownerId   String    @map("owner_id")
  type      MediaType
  url       String
  meta      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
  @@map("media_assets")
}

model DigitalTwin {
  userId     String     @id @map("user_id")
  status     TwinStatus @default(NONE)
  summary    Json?
  previewUrl String?    @map("preview_url")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user ModelProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("digital_twins")
}

model UserSettings {
  userId        String   @id @map("user_id")
  notifications Json?    @default("{\"push\": true, \"email\": true}")
  darkMode      Boolean  @default(true) @map("dark_mode")
  privacy       Json?    @default("{\"mode\": \"public\"}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Post {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageUrl  String   @map("image_url")
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]

  @@index([userId])
  @@map("posts")
}

model PostLike {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model PostSave {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_saves")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id        String   @id @default(uuid())
  reporterId String
  targetId   String
  reason     String   // "spam" | "harassment" | "inappropriate" | "fake" | "other"
  details    String?
  status     String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt  DateTime @default(now())

  reporter User @relation("reportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("reportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, status])
  @@map("reports")
}

model SavedModel {
  userId  String
  modelId String
  note    String?
  createdAt DateTime @default(now())

  user  User @relation("savedModelsByUser", fields: [userId], references: [id], onDelete: Cascade)
  model User @relation("savedModelsOfUser", fields: [modelId], references: [id], onDelete: Cascade)

  @@id([userId, modelId])
  @@index([modelId])
  @@map("saved_models")
}

// ─── Phase 3: Growth Features ───

model ProfileView {
  id        String   @id @default(uuid())
  profileId String
  viewerId  String?
  source    String?  // "discover" | "casting" | "search" | "direct"
  createdAt DateTime @default(now())

  profile User @relation("profileViews", fields: [profileId], references: [id], onDelete: Cascade)
  viewer  User? @relation("profileViewsBy", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([viewerId])
  @@map("profile_views")
}

model CastingView {
  id        String   @id @default(uuid())
  castingId String
  viewerId  String?
  createdAt DateTime @default(now())

  casting Casting @relation(fields: [castingId], references: [id], onDelete: Cascade)
  viewer  User?   @relation("castingViewsBy", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([castingId, createdAt])
  @@index([viewerId])
  @@map("casting_views")
}

model Earning {
  id          String   @id @default(uuid())
  userId      String
  castingId   String?
  amount      Int      // in cents
  currency    String   @default("EUR")
  description String?
  status      String   @default("PENDING") // PENDING, PAID, CANCELLED
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  user    User     @relation("userEarnings", fields: [userId], references: [id], onDelete: Cascade)
  casting Casting? @relation(fields: [castingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([castingId])
  @@map("earnings")
}

model Story {
  id          String    @id @default(uuid())
  userId      String
  mediaUrl    String
  mediaType   String    @default("image") // "image" | "video"
  caption     String?
  expiresAt   DateTime
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  highlightId String?

  user      User            @relation("userStories", fields: [userId], references: [id], onDelete: Cascade)
  highlight StoryHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  views     StoryView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("storyViewsBy", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@map("story_views")
}

model StoryHighlight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  coverUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user    User    @relation("userHighlights", fields: [userId], references: [id], onDelete: Cascade)
  stories Story[]

  @@index([userId, sortOrder])
  @@map("story_highlights")
}

// ─── Direct Bookings ───

model DirectBooking {
  id          String    @id @default(uuid())
  brandId     String    @map("brand_id")
  modelId     String    @map("model_id")
  title       String
  description String?
  location    String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  payAmount   Int?      @map("pay_amount")
  payCurrency String    @default("EUR") @map("pay_currency")
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  brand User @relation("brandBookings", fields: [brandId], references: [id], onDelete: Cascade)
  model User @relation("modelBookings", fields: [modelId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([modelId])
  @@map("direct_bookings")
}
